# Padronizador - configuracao opcional.
#
# O app NAO carrega este arquivo sozinho (nao ha dependencia extra para isso).
# Exporte as variaveis no seu shell antes de iniciar, por exemplo:
#   Windows cmd:    set PADRONIZADOR_PORT=5058
#   PowerShell:     $env:PADRONIZADOR_PORT = "5058"
#   Linux/macOS:    export PADRONIZADOR_PORT=5058
# Os valores abaixo sao os padroes usados quando a variavel nao esta definida.

# Porta HTTP do servidor Flask (app.py). Tambem e a porta do proxy /api do Vite
# no modo de desenvolvimento (frontend/vite.config.js) e a que o run.bat libera
# antes de iniciar.
PADRONIZADOR_PORT=5057

# Endereco de escuta do servidor. 127.0.0.1 = so esta maquina (recomendado:
# as planilhas e as decisoes ficam acessiveis apenas localmente).
PADRONIZADOR_HOST=127.0.0.1

# Memoria de decisoes entre planilhas. DESLIGADA por padrao (0).
#
# Desligada, nada do que voce decidir na revisao e salvo: cada planilha e
# revisada do zero e o arquivo data/decisions.json nem e criado.
#
# NAO ligue numa instalacao usada por mais de uma pessoa, nem com planilhas de
# mais de um escritorio. O arquivo de decisoes e UNICO e GLOBAL - nao ha
# separacao por usuario nem por conta -, entao com a memoria ligada as decisoes
# e os nomes de clientes de um escritorio apareceriam como sugestao no do
# outro.
#
# Ligue so se a instalacao for de uso pessoal, na sua propria maquina, com os
# dados de um unico escritorio.
PADRONIZADOR_MEMORIA=0
